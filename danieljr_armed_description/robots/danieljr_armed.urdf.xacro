<?xml version="1.0"?>
<!-- created with Phobos 1.0.1 "Capricious Choutengan" -->
<robot name="danieljr_armed" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find danieljr_armed_description)/urdf/utils/utils.urdf.xacro"/>
    <xacro:include filename="$(find danieljr_armed_description)/urdf/base/robot_base.urdf.xacro"/>
    <xacro:include filename="$(find danieljr_armed_description)/urdf/sensors/camera.urdf.xacro"/>
    <xacro:include filename="$(find danieljr_armed_description)/urdf/sensors/imu_sensor.urdf.xacro"/>
    <xacro:include filename="$(find danieljr_armed_description)/urdf/sensors/lidar_3d_sensor.urdf.xacro"/>
    <xacro:include filename="$(find danieljr_armed_description)/urdf/wheels/rover_wheel.urdf.xacro"/>
    <xacro:include filename="$(find danieljr_armed_description)/urdf/arm/scara.urdf.xacro"/>
    <xacro:include filename="$(find danieljr_armed_description)/urdf/arm/gripper.urdf.xacro"/>

    <xacro:arg name="prefix" default=""/>

    <xacro:utils/>
    <xacro:chasis_structure prefix="$(arg prefix)" max_s="0.06500" max_e="1.23000" close_g="0.18000"/>
    <xacro:imu_sensor_structure prefix="$(arg prefix)" conex_link="chasis_link"/>
    <xacro:lidar_3d_structure prefix="$(arg prefix)" conex_link="chasis_link"/>
    <xacro:rover_wheel_structure prefix="$(arg prefix)" conex1_link="arm_wheel_left_link" conex2_link="arm_wheel_right_link"/>
    <xacro:scara_structure prefix="$(arg prefix)" conex_link="aa_elevator_link" lp="-0.20000" up="1.80000"/>
    <xacro:gripper_structure prefix="$(arg prefix)" arm_link="arm_2_tcp_link" mc="0.06000" lr="-3.14160" ur="3.14000"/>
    <xacro:camera_structure prefix="$(arg prefix)" conex1_link="chasis_link" conex2_link="arm_2_tcp_link" h_fov="1.047" v_width="1920" v_height="1080"/>

    <!-- GAZEBO ROS -->
    <xacro:include filename="$(find danieljr_armed_description)/urdf/ros2_control.urdf.xacro"/>
    <xacro:arg name="config_controllers" default="$(find danieljr_armed_description)/config/danieljr_armed_controllers.yaml"/>
    <xacro:arg name="update_rate" default="20"/>
    <xacro:ros2_control prefix="$(arg prefix)"/>
</robot>