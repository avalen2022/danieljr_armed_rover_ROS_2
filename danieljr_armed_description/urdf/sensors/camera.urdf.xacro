<?xml version="1.0"?>
<robot name="danieljr_armed" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="camera_structure" params="prefix conex1_link conex2_link h_fov v_width v_height">
    <link name="${prefix}base_camera_front_link">
        <visual name="${prefix}camera">
        <origin rpy="0.00000 0.00000 0.00000" xyz="-0.00000 0.00000 -0.00000"/>
        <geometry>
            <mesh filename="package://danieljr_armed_description/meshes/dae/Cylinder.010.dae" scale="0.50000 1.00000 1.00000"/>
        </geometry>
        </visual>
        <collision name="${prefix}camera_collision">
            <origin rpy="0.000000 0.00000 0.00000" xyz="-0.00000 0.00000 -0.00000"/>
            <geometry>
                <mesh filename="package://danieljr_armed_description/meshes/dae/Cylinder.010.dae" scale="0.50000 1.00000 1.00000"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}base_camera_front_joint" type="fixed">
        <origin rpy="0.00000 0.00000 0.00000" xyz="1.01714 0.00000 0.09267"/>
        <parent link="${prefix}${conex1_link}"/>
        <child link="${prefix}base_camera_front_link"/>
    </joint>

    <link name="${prefix}camera_front_frame">
    </link>

    <joint name="${prefix}camera_front_frame_joint" type="fixed">
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
        <parent link="${prefix}base_camera_front_link"/>
        <child link="${prefix}camera_front_frame"/>
    </joint>

    <link name="${prefix}camera_optical_front">
    </link>
    <joint name="${prefix}camera_front_link_joint" type="fixed">
        <origin rpy="-1.57000 0.00000 -1.57000" xyz="0.00000 0.00000 0.00000"/>
        <parent link="${prefix}camera_front_frame"/>
        <child link="${prefix}camera_optical_front"/>
    </joint>

    <gazebo reference="${prefix}camera_front_frame">
        <sensor name="${prefix}camera_front_sensor" type="camera">
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>/${prefix}/camera_front/image</topic>
        <camera>
            <horizontal_fov>${h_fov}</horizontal_fov>
            <image>
            <width>${v_width}</width>
            <height>${v_height}</height>
            <format>R8G8B8</format>
            </image>
            <clip>
            <near>0.10</near>
            <far>15.0</far>
            </clip>
            <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
            </noise>
            <optical_frame_id>${prefix}camera_front_frame</optical_frame_id>
        </camera>
        </sensor>
    </gazebo>

    <link name="${prefix}base_camera_scara">
        <visual>
        <origin xyz="0 0 0.005" rpy="0 0 1.57"/>
        <geometry>
            <box size="0.1 0.05 0.05"/>
        </geometry>
        <material name="chasis"/>
        </visual>
        <collision name="${prefix}camera_scara_collision">
            <origin xyz="0 0 0.005" rpy="0 0 0"/>
            <geometry>
                <box size="0.1 0.05 0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="${prefix}base_camera_scara_joint" type="fixed">
        <origin rpy="0.00000 1.57000 0.00000" xyz="0.00000 0.00000 -0.26000"/>
        <parent link="${prefix}${conex2_link}"/>
        <child link="${prefix}base_camera_scara"/>
    </joint>

    <link name="${prefix}camera_optical_scara">
    </link>

    <joint name="${prefix}camera_scara_link_joint" type="fixed">
        <origin rpy="-1.57000 0.00000 -1.57000" xyz="0.00000 0.00000 0.00000"/>
        <parent link="${prefix}base_camera_scara"/>
        <child link="${prefix}camera_optical_scara"/>
    </joint>

    <gazebo reference="${prefix}base_camera_scara">
        <sensor name="${prefix}camera_scara_sensor" type="camera">
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <topic>/${prefix}/camera_scara/image</topic>
        <camera>
            <horizontal_fov>${h_fov}</horizontal_fov>
            <image>
            <width>${v_width}</width>
            <height>${v_height}</height>
            <format>R8G8B8</format>
            </image>
            <clip>
            <near>0.10</near>
            <far>15.0</far>
            </clip>
            <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
            </noise>
            <optical_frame_id>${prefix}base_camera_scara</optical_frame_id>
        </camera>
        </sensor>
    </gazebo>

</xacro:macro>
</robot>