<?xml version="1.0"?>
<robot name="danieljr_armed" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="lidar_3d_structure" params="prefix conex_link">
    <link name="${prefix}lidar_link">
    </link>

    <joint name="${prefix}lidar_link_joint" type="fixed">
        <parent link="${prefix}${conex_link}"/>
        <child link="${prefix}lidar_link"/>

        <origin xyz="0 0 1" rpy="0 0 0"/>
    </joint>

  <gazebo reference="${prefix}lidar_link">
    <sensor name='gpu_lidar' type='gpu_lidar'>
      <pose relative_to='${prefix}lidar_link'>0 0 0 0 0 0</pose>
      <topic>/${prefix}/lidar_sensor</topic>
      <update_rate>20</update_rate>
      <gz_frame_id>${prefix}lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>450</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.436332</min_angle>
            <max_angle>0.08726</max_angle>
          </vertical>
        </scan>
          <range>
          <min>0.2</min>
          <max>90.0</max>
          <resolution>0.02</resolution>
        </range>
      </lidar>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
</xacro:macro>
</robot>