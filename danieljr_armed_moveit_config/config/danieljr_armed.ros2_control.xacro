<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="danieljr_armed_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
            <joint name="aa_elevator_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['aa_elevator_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="arm_1_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['arm_1_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="arm_2_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['arm_2_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="arm_2_tcp_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['arm_2_tcp_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="gripper_base_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['gripper_base_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="gripper_left_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['gripper_left_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="gripper_right_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['gripper_right_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="gate_1_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['gate_1_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="gate_2_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['gate_2_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="arm_wheel_left_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['arm_wheel_left_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>
            <joint name="arm_wheel_right_link_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['arm_wheel_right_link_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort" />
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
